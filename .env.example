# Copy this file to .env before deploying outside local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=verba
JWT_SECRET_KEY=replace-with-a-long-random-secret
DEFAULT_LLM_PROVIDER=mock
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# This value is embedded into the browser bundle while the frontend image is built.
NEXT_PUBLIC_API_URL=http://localhost:8000

# YooKassa test shop. Never commit the actual secret key.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:3000/settings?payment=return
